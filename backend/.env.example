# ============================================================
# SHIBRA BACKEND — ENVIRONMENT CONFIGURATION
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.

# --------------------------
# Server
# --------------------------
NODE_ENV=development
PORT=5000

# --------------------------
# MongoDB Atlas
# --------------------------
# Create a new cluster at https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shibra?retryWrites=true&w=majority

# --------------------------
# JSON Web Token
# --------------------------
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_EXPIRES_IN=7d

# --------------------------
# OTP Configuration
# --------------------------
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# --------------------------
# MSG91 SMS / WhatsApp (Web OTP & Notifications)
# Get credentials at https://msg91.com
# --------------------------
MSG91_AUTH_KEY=your-msg91-auth-key
MSG91_SENDER_ID=SHIBRA
MSG91_TEMPLATE_ID=your-otp-template-id

# --------------------------
# Firebase Admin (Mobile App OTP + Push Notifications)
# Create project at https://console.firebase.google.com
# --------------------------
FIREBASE_PROJECT_ID=shibra-app
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@shibra-app.iam.gserviceaccount.com

# --------------------------
# AWS S3 (Image Storage)
# Create bucket at https://s3.console.aws.amazon.com
# --------------------------
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=shibra-uploads

# --------------------------
# Payment — COD & UPI QR (default, Razorpay can be added later)
# --------------------------
COD_PARTIAL_PAYMENT_PERCENTAGE=30

# --------------------------
# Admin Seed (used by npm run seed:admin)
# --------------------------
ADMIN_EMAIL=admin@shibra.com
ADMIN_PASSWORD=ChangeMe@123
ADMIN_NAME=Shibra Admin

# --------------------------
# App URLs
# --------------------------
FRONTEND_URL=https://www.shibrab2b.com
ADMIN_URL=https://admin.shibrab2b.com
API_URL=https://api.shibrab2b.com
