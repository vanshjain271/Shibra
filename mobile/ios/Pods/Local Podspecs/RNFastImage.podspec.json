{
  "name": "RNFastImage",
  "version": "8.13.0",
  "summary": "🚩 FastImage, performant React Native image component.",
  "authors": {
    "Dylan Vann": "dylan@dylanvann.com"
  },
  "homepage": "https://github.com/DylanVann/react-native-fast-image#readme",
  "license": "MIT",
  "frameworks": "UIKit",
  "requires_arc": true,
  "source": {
    "git": "https://github.com/DylanVann/react-native-fast-image.git",
    "tag": "v8.13.0"
  },
  "pod_target_xcconfig": {
    "HEADER_SEARCH_PATHS": [
      "\"$(PODS_ROOT)/boost\"",
      "\"$(PODS_ROOT)/boost-for-react-native\"",
      "\"$(PODS_ROOT)/RCT-Folly\"",
      "\"$(PODS_ROOT)/Headers/Private/Yoga\"",
      "$(PODS_ROOT)/glog",
      "$(PODS_ROOT)/boost",
      "$(PODS_ROOT)/DoubleConversion",
      "$(PODS_ROOT)/fast_float/include",
      "$(PODS_ROOT)/fmt/include",
      "$(PODS_ROOT)/SocketRocket",
      "$(PODS_ROOT)/RCT-Folly"
    ],
    "CLANG_CXX_LANGUAGE_STANDARD": "c++20",
    "OTHER_CPLUSPLUSFLAGS": "$(inherited) -DRCT_NEW_ARCH_ENABLED=1 ",
    "OTHER_SWIFT_FLAGS": "$(inherited) -DRCT_NEW_ARCH_ENABLED"
  },
  "platforms": {
    "ios": "11.0",
    "tvos": "11.0"
  },
  "compiler_flags": "-DFOLLY_NO_CONFIG -DFOLLY_MOBILE=1 -DFOLLY_CFG_NO_COROUTINES=1 -DFOLLY_USE_LIBCPP=1 -Wno-comma -Wno-shorten-64-to-32 -DRCT_NEW_ARCH_ENABLED  -DRCT_NEW_ARCH_ENABLED=1",
  "source_files": "ios/**/*.{h,m,mm,cpp}",
  "dependencies": {
    "React-Core": [],
    "React-RCTFabric": [],
    "ReactCodegen": [],
    "RCTRequired": [],
    "RCTTypeSafety": [],
    "ReactCommon/turbomodule/bridging": [],
    "ReactCommon/turbomodule/core": [],
    "React-NativeModulesApple": [],
    "Yoga": [],
    "React-Fabric": [],
    "React-graphics": [],
    "React-utils": [],
    "React-featureflags": [],
    "React-debug": [],
    "React-ImageManager": [],
    "React-rendererdebug": [],
    "React-jsi": [],
    "React-renderercss": [],
    "hermes-engine": [],
    "glog": [],
    "boost": [],
    "DoubleConversion": [],
    "fast_float": [],
    "fmt": [],
    "RCT-Folly": [],
    "SocketRocket": [],
    "RCT-Folly/Fabric": [],
    "SDWebImage": [
      ">= 5.19.1"
    ],
    "SDWebImageWebPCoder": [
      "~> 0.14"
    ],
    "SDWebImageAVIFCoder": [
      "~> 0.11.0"
    ],
    "SDWebImageSVGCoder": [
      "~> 1.7.0"
    ],
    "libavif/libdav1d": [
      "~> 0.11.1"
    ],
    "libavif/core": [
      "~> 0.11.1"
    ]
  }
}
