# ============================================================
# SHIBRA MOBILE APP — ENVIRONMENT CONFIGURATION  
# ============================================================
# Rename to .env and fill in actual values

# Backend API
API_BASE_URL=https://api.shibrab2b.com/api/v1

# Firebase (create new project at console.firebase.google.com)
# Add google-services.json to android/app/ 
# Add GoogleService-Info.plist to ios/mobile/

# App Store / Play Store
BUNDLE_ID=com.shibra.app
ANDROID_PACKAGE=com.shibra.app
